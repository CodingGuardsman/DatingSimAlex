{
  "name": "after-class",
  "productName": "After Class",
  "version": "1.1.0",
  "description": "A meta-horror dating sim about the last week before summer.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodingGuardsman/DatingSimAlex.git"
  },
  "author": "Bryan Lee",
  "license": "ISC",
  "type": "commonjs",
  "homepage": "https://github.com/CodingGuardsman/DatingSimAlex#readme",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.afterclass.game",
    "productName": "After Class",
    "files": [
      "index.html",
      "src/**/*",
      "styles/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "artifactName": "After Class.exe",
      "signAndEditExecutable": false
    }
  }
}
